# Local settings for the owner-run real probe only (`npm run real`). Copy to .env (git-ignored) and fill in.
# The server never reads this file and never calls out; only scripts/real-probe.mjs does.
# The probe refuses to run while a placeholder is left: .example / .invalid hosts, and the values "replace-me" and "agent-client-example".
# The token's audience is DOOR_URL itself, so there is no separate audience setting.
# Basic client authentication is used: the client must allow client_secret_basic.
PF_ISSUER=https://pf.example
PF_CLIENT_ID=agent-client-example
PF_CLIENT_SECRET=replace-me
# The scope your door's grant needs (space-separated if more than one).
PF_SCOPE=replace-me
DOOR_URL=https://door.example/mcp
# Optional: the index CountTool is asked about (default gateway-events, the one that existed on the door the probe was run against on 2026-11-16).
# PROBE_INDEX=gateway-events

# Owner shortcut: the shared central copy of these values lives in
# ~/Development/.ping-labs/pf-route-c.env — symlink it instead of filling this
# file by hand:  ln -sf /Users/cmuir/Development/.ping-labs/pf-route-c.env .env
